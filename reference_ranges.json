          "category": "lipid_profile",
          "condition": "value < 200",
          "max_exclusive": 200,
          "status": "DESIRABLE",
          "explanation": "Total cholesterol under 200 mg/dL is desirable."
        },
        {
          "rule_id": "CHOLESTEROL_BORDERLINE_001",
          "category": "lipid_profile",
          "condition": "200 <= value <= 239",
          "min_inclusive": 200,
          "max_inclusive": 239,
          "status": "BORDERLINE_HIGH",
          "explanation": "Total cholesterol 200 to 239 mg/dL is borderline high."
        },
        {
          "rule_id": "CHOLESTEROL_HIGH_001",
          "category": "lipid_profile",
          "condition": "value >= 240",
          "min_inclusive": 240,
          "status": "HIGH",
          "explanation": "Total cholesterol 240 mg/dL or higher is high."
        }
      ]
    },

    "ldl_cholesterol": {
      "aliases": [
        "LDL",
        "LDL-C",
        "Low Density Lipoprotein"
      ],
      "unit": "mg/dL",
      "type": "category",
      "source": "NCEP ATP III Guidelines",
      "provenance_status": "VERIFIED",
      "rules": [
        {
          "rule_id": "LDL_OPTIMAL_001",
          "category": "lipid_profile",
          "condition": "value < 100",
          "max_exclusive": 100,
          "status": "OPTIMAL",
          "explanation": "LDL cholesterol below 100 mg/dL is optimal."
        },
        {
          "rule_id": "LDL_NEAR_OPTIMAL_001",
          "category": "lipid_profile",
          "condition": "100 <= value <= 130",
          "min_inclusive": 100,
          "max_inclusive": 130,
          "status": "NEAR_OPTIMAL",
          "explanation": "LDL cholesterol 100 to 130 mg/dL is near optimal."
        },
        {
          "rule_id": "LDL_BORDERLINE_001",
          "category": "lipid_profile",
          "condition": "130 <= value <= 160",
          "min_inclusive": 130,
          "max_inclusive": 160,
          "status": "BORDERLINE_HIGH",
          "explanation": "LDL cholesterol 130 to 160 mg/dL is borderline high."
        },
        {
          "rule_id": "LDL_HIGH_001",
          "category": "lipid_profile",
          "condition": "160 <= value <= 190",
          "min_inclusive": 160,
          "max_inclusive": 190,
          "status": "HIGH",
          "explanation": "LDL cholesterol 160 to 190 mg/dL is high."
        },
        {
          "rule_id": "LDL_VERY_HIGH_001",
          "category": "lipid_profile",
          "condition": "value >= 190",
          "min_inclusive": 190,
          "status": "VERY_HIGH",
          "explanation": "LDL cholesterol 190 mg/dL or higher is very high."
        }
      ]
    },

    "hdl_cholesterol": {
      "aliases": [
        "HDL",
        "HDL-C",
        "High Density Lipoprotein"
      ],
      "unit": "mg/dL",
      "type": "category",
      "source": "NCEP ATP III Guidelines",
      "provenance_status": "VERIFIED",
      "rules": [
        {
          "rule_id": "HDL_LOW_001",
          "category": "lipid_profile",
          "condition": "value < 40",
          "max_exclusive": 40,
          "status": "LOW",
          "explanation": "HDL cholesterol below 40 mg/dL is low."
        },
        {
          "rule_id": "HDL_ACCEPTABLE_001",
          "category": "lipid_profile",
          "condition": "value >= 40",
          "min_inclusive": 40,
          "status": "ACCEPTABLE",
          "explanation": "HDL cholesterol 40 mg/dL or higher is acceptable."
        }
      ]
    },

    "triglycerides": {
      "aliases": [
        "Triglycerides",
        "TG"
