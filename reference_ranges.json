          "max_exclusive": 200,
          "status": "BORDERLINE_HIGH",
          "explanation": "Triglycerides 150 to 199 mg/dL is borderline high."
        },
        {
          "rule_id": "TRIGLYCERIDES_HIGH_001",
          "category": "lipid_profile",
          "condition": "200 <= value < 500",
