          "condition": "60 <= value < 90",
          "min_inclusive": 60,
          "max_exclusive": 90,
          "status": "MILDLY_DECREASED",
          "explanation": "eGFR 60-89 indicates mildly decreased GFR."
        },
        {
          "rule_id": "EGFR_MODERATE_001",
          "category": "kidney",
          "condition": "30 <= value < 60",
          "min_inclusive": 30,
          "max_exclusive": 60,
          "status": "MODERATELY_DECREASED",
          "explanation": "eGFR 30-59 indicates moderately decreased GFR."
        },
        {
          "rule_id": "EGFR_SEVERE_001",
          "category": "kidney",
          "condition": "15 <= value < 30",
          "min_inclusive": 15,
          "max_exclusive": 30,
          "status": "SEVERELY_DECREASED",
          "explanation": "eGFR 15-29 indicates severely decreased GFR."
        },
        {
          "rule_id": "EGFR_FAILURE_001",
          "category": "kidney",
          "condition": "value < 15",
          "max_exclusive": 15,
          "status": "KIDNEY_FAILURE_RANGE",
          "explanation": "eGFR < 15 is within kidney failure range."
        }
      ]
    }
