{
  "metadata": {
    "name": "Medical Laboratory Reference Rules",
    "version": "2.0",
    "purpose": "Deterministic rule-engine evaluation with provenance and rule auditability",
    "warning": "Generic reference values are for software testing and educational use. When a patient report provides its own reference range, use that range first."
  },

  "diabetes": {
    "hba1c": {
      "aliases": [
        "HbA1c",
        "HbA1",
        "Hemoglobin A1c",
        "Glycated Hemoglobin",
        "Glycosylated Hemoglobin",
        "Glycosylated Haemoglobin"
      ],
      "unit": "%",
      "type": "category",
      "source": "ADA 2024 Standards of Care",
      "provenance_status": "VERIFIED",
      "rules": [
        {
          "rule_id": "HBA1C_NORMAL_001",
          "category": "diabetes",
          "condition": "value < 5.7",
          "max_exclusive": 5.7,
          "status": "NORMAL",
          "explanation": "HbA1c below 5.7% is within the normal glycemic reference range."
        },
        {
          "rule_id": "HBA1C_PREDIABETES_001",
          "category": "diabetes",
          "condition": "5.7 <= value < 6.5",
          "min_inclusive": 5.7,
          "max_exclusive": 6.5,
          "status": "PREDIABETES",
          "explanation": "HbA1c between 5.7% and 6.4% indicates prediabetes glycemic range."
        },
        {
          "rule_id": "HBA1C_DIABETES_RANGE_001",
          "category": "diabetes",
          "condition": "value >= 6.5",
          "min_inclusive": 6.5,
          "status": "DIABETES_RANGE",
          "explanation": "HbA1c 6.5% or higher is within the diabetes diagnostic threshold range."
        }
      ]
    },

    "mean_blood_glucose": {
      "aliases": [
        "Mean Blood Glucose",
        "Average Blood Glucose",
        "eAG",
        "MBG",
        "Estimated Average Glucose"
      ],
      "unit": "mg/dL",
      "type": "reference_range",
      "source": "ADA 2024 Standards of Care (eAG Formula)",
      "provenance_status": "VERIFIED",
      "rule_id_low": "MBG_LOW_001",
      "rule_id_normal": "MBG_NORMAL_001",
      "rule_id_high": "MBG_HIGH_001",
      "reference": {
        "min": 70,
        "max": 154
      }
    },

    "fasting_glucose": {
      "aliases": [
        "Fasting Glucose",
        "Fasting Blood Sugar",
        "FBS",
        "FPG",
        "Fasting Plasma Glucose"
      ],
      "unit": "mg/dL",
      "type": "category",
      "source": "ADA 2024 Standards of Care",
      "provenance_status": "VERIFIED",
      "rules": [
        {
          "rule_id": "FASTING_GLUCOSE_NORMAL_001",
          "category": "diabetes",
          "condition": "value <= 99",
          "max_inclusive": 99,
          "status": "NORMAL",
          "explanation": "Fasting blood glucose up to 99 mg/dL is normal."
        },
        {
          "rule_id": "FASTING_GLUCOSE_PREDIABETES_001",
          "category": "diabetes",
          "condition": "100 <= value <= 125",
          "min_inclusive": 100,
          "max_inclusive": 125,
          "status": "PREDIABETES_RANGE",
          "explanation": "Fasting blood glucose 100 to 125 mg/dL indicates impaired fasting glucose (prediabetes range)."
        },
        {
          "rule_id": "FASTING_GLUCOSE_DIABETES_RANGE_001",
          "category": "diabetes",
          "condition": "value >= 126",
          "min_inclusive": 126,
          "status": "DIABETES_RANGE",
          "explanation": "Fasting blood glucose 126 mg/dL or higher is within the diabetes threshold range."
        }
      ]
    },

    "ogtt_2_hour": {
      "aliases": [
        "2 Hour Glucose",
        "2h Glucose",
        "OGTT",
        "Oral Glucose Tolerance Test"
      ],
      "unit": "mg/dL",
      "type": "category",
      "source": "ADA 2024 Standards of Care",
      "provenance_status": "VERIFIED",
      "rules": [
        {
          "rule_id": "OGTT_NORMAL_001",
          "category": "diabetes",
          "condition": "value <= 139",
          "max_inclusive": 139,
          "status": "NORMAL",
          "explanation": "2-hour OGTT below 140 mg/dL is normal."
        },
        {
          "rule_id": "OGTT_PREDIABETES_001",
          "category": "diabetes",
          "condition": "140 <= value <= 199",
          "min_inclusive": 140,
          "max_inclusive": 199,
          "status": "PREDIABETES_RANGE",
          "explanation": "2-hour OGTT 140 to 199 mg/dL indicates impaired glucose tolerance."
        },
        {
          "rule_id": "OGTT_DIABETES_RANGE_001",
          "category": "diabetes",
          "condition": "value >= 200",
          "min_inclusive": 200,
          "status": "DIABETES_RANGE",
          "explanation": "2-hour OGTT 200 mg/dL or higher is within the diabetes threshold range."
        }
      ]
    },

    "random_glucose": {
      "aliases": [
        "Random Glucose",
        "Random Blood Sugar",
        "RBS",
        "Random Plasma Glucose"
      ],
      "unit": "mg/dL",
      "type": "clinical_threshold",
      "source": "ADA 2024 Standards of Care",
      "provenance_status": "VERIFIED",
      "rules": [
        {
          "rule_id": "RANDOM_GLUCOSE_HIGH_001",
          "category": "diabetes",
          "condition": "value >= 200",
          "min_inclusive": 200,
          "status": "DIABETES_RANGE_IF_SYMPTOMS",
          "explanation": "Random glucose >= 200 mg/dL in presence of hyperglycemia symptoms warrants clinical evaluation."
        }
      ]
    }
  },

  "lipid_profile": {
